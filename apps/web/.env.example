# Leave empty locally (Vite proxies /api to localhost:8000).
# In production set it to the API origin, e.g. https://matchpoint-api.onrender.com
VITE_API_URL=

# "true" (default) runs the in-browser mock backend in src/lib/mock.ts.
# Set to "false" once the FastAPI endpoints exist. The header toggle overrides this per browser.
VITE_API_MOCK=true
